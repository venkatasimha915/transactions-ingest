{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": { "IncludeScopes": true, "TimestampFormat": "HH:mm:ss " }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Transactions": "Data Source=transactions.db"
  },
  "Import": {
    "ReconciliationWindowHours": 24
  },
  "SourceSystems": {
    "DataDirectory": "SampleData",
    "Systems": [
      { "Name": "Store Uptown",   "File": "store-uptown.json",   "SimulateFailure": false },
      { "Name": "Store Downtown", "File": "store-downtown.json", "SimulateFailure": false },
      { "Name": "Online",         "File": "online.json",         "SimulateFailure": false }
    ]
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  }
}
